[Unit]
Description=Prism eBPF Observability Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/prism-agent --config /etc/prism/config.yaml
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
ReadWritePaths=/sys/fs/bpf
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
